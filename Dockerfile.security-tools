COPY --from=halmos-root / /usr/local/share/ga-security/toolroots/halmos/
COPY --from=builder /out/tools/forge /usr/local/share/ga-security/toolroots/halmos/usr/local/bin/forge
RUN cp -L /usr/local/share/ga-security/toolroots/slither/home/ethsec/.local/bin/solc /usr/local/share/ga-security/toolroots/halmos/usr/local/bin/solc \
    && for root in owasp-zap schemathesis sslyze nmap zeek suricata mythril slither semgrep halmos; do mkdir -p "/usr/local/share/ga-security/toolroots/${root}/work" "/usr/local/share/ga-security/toolroots/${root}/etc"; rm -f "/usr/local/share/ga-security/toolroots/${root}/etc/resolv.conf" "/usr/local/share/ga-security/toolroots/${root}/etc/hosts"; : > "/usr/local/share/ga-security/toolroots/${root}/etc/resolv.conf"; : > "/usr/local/share/ga-security/toolroots/${root}/etc/hosts"; done \
    && printf '%s\n' 'sha256:7840969c7c9fead565bf9734b12f49f6886db90b1d35b1f74d79710bbd081dab' > /usr/local/share/ga-security/toolroots/owasp-zap/.ga-oci-digest \
    && printf '%s\n' 'sha256:153e544c9eefd31c7a0aabc40c7d90bf66c36915e2e4ccba968319da453006b2' > /usr/local/share/ga-security/toolroots/schemathesis/.ga-oci-digest \
