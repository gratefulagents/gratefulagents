# Halmos' upstream 0.3.3 image is amd64-only. Build the reviewed Z3-only
# Python closure for both release architectures; hashes in these locks cover
# every downloaded wheel. The reviewed closure uses Z3 4.13.0.0 (the first
# compatible release with Linux arm64 wheels) instead of Halmos' amd64-only
# 4.12.6.0 pin. Pinned Forge and the architecture-matched compiler from the
# immutable Slither toolbox root are added below.
FROM docker.io/library/python:3.11-slim-bookworm@sha256:d29f48a31a8b408ed19272ca1e7b10ebae13b240a27e862d3d4217c528e2e0c3 AS halmos-root
COPY security-tool-requirements/halmos-deps.lock security-tool-requirements/halmos.lock /tmp/
RUN python -m venv /opt/halmos \
    && /opt/halmos/bin/pip install --no-cache-dir --only-binary=:all: --require-hashes -r /tmp/halmos-deps.lock \
    && /opt/halmos/bin/pip install --no-cache-dir --no-deps --require-hashes -r /tmp/halmos.lock \
    && /opt/halmos/bin/halmos --version

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce AS bwrap-builder
ARG BWRAP_VERSION=0.11.2
ARG BWRAP_SHA256=69abc30005d2186baf7737feacd8da35633b93cf5af38838ecff17c5f8e924f6
RUN apk add --no-cache build-base meson libcap-dev libcap-static linux-headers curl xz
RUN curl -fsSL -o /tmp/bwrap.tar.xz "https://github.com/containers/bubblewrap/releases/download/v${BWRAP_VERSION}/bubblewrap-${BWRAP_VERSION}.tar.xz" \
    && echo "${BWRAP_SHA256}  /tmp/bwrap.tar.xz" | sha256sum -c - \
    && tar -xJf /tmp/bwrap.tar.xz -C /tmp \
    && cd "/tmp/bubblewrap-${BWRAP_VERSION}" \
    && LDFLAGS=-static meson setup build --prefer-static -Dman=disabled -Dselinux=disabled -Dbash_completion=disabled -Dzsh_completion=disabled -Dtests=false \
    && meson compile -C build && strip build/bwrap

# Reproducible standalone deterministic security-tool runtime. Base image
# manifest lists and every release archive are immutable/checksum pinned.
FROM --platform=$BUILDPLATFORM golang:1.26@sha256:2005724102f45917a63e9d092fc0e4ea56ea575048ce147caad5f5f61502c365 AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /workspace
ENV GOTOOLCHAIN=local

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -trimpath -buildvcs=false -o /out/ga-security ./cmd/ga-security
RUN go run ./cmd/install-security-tools security-tools.lock.json /out/tools linux/${TARGETARCH}

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241
WORKDIR /workspace
COPY --from=builder /out/ga-security /usr/local/bin/ga-security
COPY --from=builder /out/tools/ /usr/local/bin/
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY security-tools.lock.json /usr/local/share/ga-security/security-tools.lock.json
COPY security-knowledge/nuclei-reviewed.yaml /usr/local/share/ga-security/knowledge/nuclei-reviewed.yaml
COPY --from=bwrap-builder /tmp/bubblewrap-0.11.2/build/bwrap /usr/local/bin/bwrap
COPY --from=zap-root / /usr/local/share/ga-security/toolroots/owasp-zap/
COPY --from=schemathesis-root / /usr/local/share/ga-security/toolroots/schemathesis/
COPY --from=sslyze-root / /usr/local/share/ga-security/toolroots/sslyze/
