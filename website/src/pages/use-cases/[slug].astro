---
import Base from '../../layouts/Base.astro';
import {useCases, type UseCase} from '../../data/usecases';

export function getStaticPaths() {
  return useCases.map((useCase) => ({
    params: {slug: useCase.slug},
    props: {useCase},
  }));
}

interface Props {
  useCase: UseCase;
}

const {useCase} = Astro.props;
const siteUrl = Astro.site ?? Astro.url;
const abs = (p: string) => new URL(p, siteUrl).toString();
const canonical = abs(`/use-cases/${useCase.slug}/`);
const others = useCases.filter((item) => item.slug !== useCase.slug);
const anchor = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const sectionIds = useCase.sections.map((section) => anchor(section.heading));

const structuredData = [
  {
    '@type': 'Article',
    '@id': `${canonical}#article`,
    headline: useCase.title,
    description: useCase.description,
    url: canonical,
    isPartOf: {'@id': abs('/#website')},
    author: {'@id': abs('/#organization')},
    publisher: {'@id': abs('/#organization')},
    about: {'@id': abs('/#software')},
  },
  {
    '@type': 'HowTo',
    '@id': `${canonical}#howto`,
    name: `Get started: ${useCase.title}`,
    step: useCase.steps.map((step, index) => ({
      '@type': 'HowToStep',
      position: index + 1,
      name: step,
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {'@type': 'ListItem', position: 1, name: 'GratefulAgents', item: abs('/')},
      {'@type': 'ListItem', position: 2, name: 'Use cases', item: abs('/use-cases/')},
      {'@type': 'ListItem', position: 3, name: useCase.title, item: canonical},
    ],
  },
];
---

<Base title={useCase.seoTitle} description={useCase.description} {structuredData} type="article">
  <main id="main">
    <div class="sheet-head">
      <div class="sheet-head-inner">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">GratefulAgents</a>
          <span aria-hidden="true">/</span>
          <a href="/use-cases/">Use cases</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{useCase.eyebrow}</span>
        </nav>
        <h1>{useCase.title}</h1>
        <p>{useCase.summary}</p>
      </div>
    </div>

    <div class="sheet-body">
      <article class="sheet-main">
        <section class="brief">
          <h2>Why this matters</h2>
          <p>{useCase.problem}</p>
        </section>

        {
          useCase.sections.map((section, index) => (
            <section id={sectionIds[index]}>
              <h2>{section.heading}</h2>
              {section.body.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </section>
          ))
        }

        <section id="getting-there">
          <h2>Getting there</h2>
          <ol class="procedure">
            {useCase.steps.map((step) => <li>{step}</li>)}
          </ol>
        </section>

        <section>
          <h2>Keep reading</h2>
          <ul class="related">
            {
              others.map((item) => (
                <li>
                  <a href={`/use-cases/${item.slug}/`}>
                    {item.title} <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </article>

      <aside class="sheet-aside" aria-label="Page and documentation navigation">
        <nav class="aside-card">
          <h2>kind: Contents</h2>
          <ul>
            {useCase.sections.map((section, index) => (
              <li><a href={`#${sectionIds[index]}`}>{section.heading}</a></li>
            ))}
            <li><a href="#getting-there">Getting there</a></li>
          </ul>
        </nav>
        <nav class="aside-card">
          <h2>kind: Documentation</h2>
          <ul>
            {useCase.docs.map((doc) => (
              <li><a href={doc.href}>{doc.label}</a></li>
            ))}
          </ul>
        </nav>
        <div class="aside-card">
          <h2>kind: Try it</h2>
          <ul>
            <li><a href="/docs/getting-started/self-hosting-kind/">Run the Kind demo</a></li>
            <li><a href="/faq/">Read the FAQ</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </main>
</Base>
