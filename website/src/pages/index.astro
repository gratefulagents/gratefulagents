---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import {repositoryUrl} from '../data/sidebar';
import type {MarkName} from '../data/marks';

const triggers: {mark: MarkName; name: string; href: string}[] = [
  {mark: 'github', name: 'GitHub', href: '/docs/integrations/github/'},
  {mark: 'linear', name: 'Linear', href: '/docs/integrations/linear/'},
  {mark: 'slack', name: 'Slack', href: '/docs/integrations/slack/'},
  {mark: 'cron', name: 'Cron', href: '/docs/projects/cron/'},
];

const providers: {mark: MarkName; name: string}[] = [
  {mark: 'anthropic', name: 'Claude'},
  {mark: 'openai', name: 'OpenAI'},
  {mark: 'openrouter', name: 'OpenRouter'},
  {mark: 'xai', name: 'Grok'},
  {mark: 'copilot', name: 'Copilot'},
];

const kindGuidePath = '/docs/getting-started/self-hosting-kind/';
const kindInstallPrompt = 'Read https://gratefulagents.dev/docs/getting-started/self-hosting-kind/ and install gratefulagents on my laptop with Kind. Verify Docker and the other prerequisites first, run the installer, then give me the URL and the credentials I need to sign in.';
const homepageDescription = 'Run open-source coding agents in your Kubernetes cluster. Trigger work from GitHub, Linear, Slack, or schedules; bring your own models and inspect every run.';

const faqItems: {q: string; a: string}[] = [
  {
    q: 'Is GratefulAgents really self-hosted?',
    a: 'Yes. The Kubernetes controller, dashboard, and all agent run sandboxes execute entirely inside your own cluster. Nothing phones home to a GratefulAgents cloud. Your source code, prompts, and model responses travel between your cluster and the model provider of your choice — never through our infrastructure.',
  },
  {
    q: 'Do I need Kubernetes experience to get started?',
    a: 'You need a working cluster, but not deep expertise. The fastest path is the Kind guide: one script spins up a local cluster on a macOS or Linux laptop in minutes. For a persistent server install, the k3s guide walks through a fresh Debian or Ubuntu machine end to end. Both guides cover every prerequisite.',
  },
  {
    q: 'Which AI models can I use?',
    a: 'Any provider whose credentials you store in your workspace: Claude (Anthropic), OpenAI, OpenRouter (which surfaces many hosted models), Grok (xAI), and GitHub Copilot. Credentials are saved in your workspace and leave your cluster only when an agent makes an inference request directly to that provider\'s API.',
  },
  {
    q: 'How is this different from GitHub Copilot\'s coding agent?',
    a: 'Copilot\'s coding agent is a cloud SaaS feature. Your code and prompts are processed on GitHub\'s infrastructure, and you cannot inspect the execution harness. GratefulAgents runs entirely in your cluster — you own the sandbox, the model credentials, the traces, and the execution logs. You can also trigger work from Linear, Slack, or cron, not just GitHub issues.',
  },
  {
    q: 'How is this different from OpenHands?',
    a: 'OpenHands is an open-source single-agent harness focused on the execution loop. GratefulAgents is a complete Kubernetes-native platform: a controller manager with CRDs, multi-client apps (web, desktop, iOS, Android), trigger integrations (GitHub, Linear, Slack, cron), RBAC and workspace sharing, an Agent Ops console, and per-run observability across cost, tokens, traces, and subagent graphs.',
  },
  {
    q: 'Can agents open pull requests and interact with GitHub?',
    a: 'Yes. Agents run with your configured GitHub credentials and can read issues, create branches, commit, open pull requests, and post review comments — the same actions a developer would take. You can also trigger runs automatically when a GitHub issue or PR comment matches a pattern and have the agent respond or open a PR directly.',
  },
  {
    q: 'What does GratefulAgents cost?',
    a: 'The software is free and open source under the AGPL-3.0 licence. You pay only for the model-provider API calls your agents make — charged directly by Anthropic, OpenAI, or whichever provider you configure — and for the compute running your Kubernetes cluster. There is no GratefulAgents subscription or per-seat fee.',
  },
  {
    q: 'Is it ready for production use?',
    a: 'GratefulAgents is in active early development. It works well for evaluation, prototyping, and internal team use, but you should expect bugs and breaking changes between releases. High availability, managed hosting, and a production support SLA are not documented. We recommend starting with the Kind local demo before committing to a persistent server deployment.',
  },
];

const structuredData = [
  {
    '@type': 'SoftwareApplication',
    '@id': 'https://gratefulagents.dev/#software',
    name: 'GratefulAgents',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Kubernetes, Web, macOS, Windows, Linux, iOS, Android',
    url: 'https://gratefulagents.dev/',
    description: homepageDescription,
    codeRepository: repositoryUrl,
    license: 'https://www.gnu.org/licenses/agpl-3.0.html',
    isAccessibleForFree: true,
    offers: {'@type': 'Offer', price: '0', priceCurrency: 'USD'},
    featureList: [
      'Self-hosted coding agent execution on Kubernetes',
      'GitHub, Linear, Slack, and scheduled triggers',
      'Bring-your-own model providers',
      'Run traces, cost, token, and reliability observability',
      'Web, desktop, iOS, and Android clients',
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': 'https://gratefulagents.dev/#faq',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {'@type': 'Answer', text: item.a},
    })),
  },
  {
    '@type': 'VideoObject',
    '@id': 'https://gratefulagents.dev/#hero-video',
    name: 'GratefulAgents: one agent run from prompt to trace',
    description: 'A recording of a single agent run — a prompt fans out to a subagent DAG, the work completes, and the full trace is inspected — replayed at 4× speed.',
    thumbnailUrl: 'https://gratefulagents.dev/screens/run-recording-poster.webp',
    contentUrl: 'https://gratefulagents.dev/screens/run-recording.mp4',
    // Commit date of website/public/screens/run-recording.mp4 (28a75fe).
    // Keep this in sync if the recording is replaced.
    uploadDate: '2026-07-20',
  },
];

const slides = [
  {
    kind: 'Sheet 02 · Operate',
    title: 'Every run on one board',
    desc: 'See live work, blockers, cost, and recent outcomes across the workspace. Step in only when a run needs you.',
    href: '/docs/runs/review-activity/',
    shot: '/screens/agent-ops.webp?v=4',
    alt: 'Agent Ops board listing live runs with state, mode, latest activity, cost, and age columns',
  },
  {
    kind: 'Sheet 03 · Measure',
    title: 'Reliability across runs',
    desc: 'Compare cost, tokens, tools, subagents, compactions, and errors across models and time.',
    href: '/docs/results/observability/',
    shot: '/screens/observability.webp?v=5',
    alt: 'Observability dashboard showing generation spend, run cost, tokens, tool calls, subagents, reliability, and model breakdowns',
  },
  {
    kind: 'Sheet 04 · Orchestrate',
    title: 'Fan out, stay in control',
    desc: 'Delegate to specialist subagents and watch the dependency graph run — every node inspectable while it works.',
    href: '/docs/runs/review-activity/',
    shot: '/screens/graph.webp?v=4',
    alt: 'Subagent graph view showing a root run spawning writer and explore subagents with live status',
  },
  {
    kind: 'Sheet 05 · Inspect',
    title: 'Every turn has a trace',
    desc: 'Open timing, tool calls, token usage, cost, and errors for any run. The harness never becomes a black box.',
    href: '/docs/runs/meta-harness-traces/',
    shot: '/screens/trace.webp?v=5',
    alt: 'Trace timeline of a run showing per-turn LLM calls, WebFetch tool spans, durations, and costs',
  },
  {
    kind: 'Sheet 06 · Move',
    title: 'The run stays with you',
    desc: 'Follow, steer, and review from iOS or Android while the compute keeps running in your cluster.',
    href: '/docs/getting-started/web-desktop-workspaces/',
    shots: ['/screens/tablet-1.webp?v=5', '/screens/tablet-2.webp?v=5'],
    alt: 'iPad views of the gratefulagents app following and steering a live agent run',
  },
];

const stations = [
  {kind: 'Start', title: 'Getting started', desc: 'Deploy, secure, sign in, and connect a workspace.', href: '/docs/getting-started/quick-start/'},
  {kind: 'Run', title: 'Agent runs', desc: 'Start work, steer mid-flight, change modes, and review traces.', href: '/docs/runs/start-a-run/'},
  {kind: 'Automate', title: 'Projects & schedules', desc: 'Save run defaults per repository and launch on a schedule.', href: '/docs/projects/projects/'},
  {kind: 'Connect', title: 'Integrations', desc: 'Create and steer runs from GitHub, Linear, and Slack.', href: '/docs/integrations/github/'},
  {kind: 'Control', title: 'Resources', desc: 'Skills, MCP servers, runtime profiles, policies, modes, and roles.', href: '/docs/settings/resources/'},
  {kind: 'Configure', title: 'Settings', desc: 'Credentials, model preferences, personas, and Git identity.', href: '/docs/settings/account-appearance/'},
  {kind: 'Share', title: 'Collaboration', desc: 'Give teammates the right access to projects and runs.', href: '/docs/collaboration/sharing-and-permissions/'},
  {kind: 'Recover', title: 'Troubleshooting', desc: 'Resolve credential, integration, and workspace problems.', href: '/docs/troubleshooting/common-issues/'},
];
---

<Base
  title="Self-Hosted Coding Agents for Kubernetes | GratefulAgents"
  description={homepageDescription}
  {structuredData}
  bodyClass="is-home"
>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-main">
        <div class="hero-copy">
          <img class="hero-logo" src="/logo.png" alt="" width="72" height="72" loading="eager" decoding="async" />
          <p class="eyebrow"><span class="signal"></span> Open source · Kubernetes native</p>
          <h1 id="hero-title">self-hosted coding agents <span>for Kubernetes teams</span></h1>
          <p class="hero-sub">Run, steer, and audit agent work in your own infrastructure. Connect engineering tools and your preferred model providers to one observable execution platform.</p>
          <div class="cta-row">
            <a class="btn btn-primary" href={kindGuidePath}>Run the Kind demo <span aria-hidden="true">→</span></a>
            <a class="btn btn-quiet" href={repositoryUrl}>View source <span aria-hidden="true">↗</span></a>
            <a class="hero-clients" href="/docs/getting-started/web-desktop-workspaces/">
              <span>Clients</span>
              <strong>Web · Desktop · iOS · Android</strong>
            </a>
          </div>
          <aside class="hero-install" aria-labelledby="hero-install-title">
            <div>
              <span class="hero-install-key">Kind demo · macOS or Linux</span>
              <strong id="hero-install-title">Have your coding agent install it.</strong>
            </div>
            <button
              type="button"
              class="hero-install-copy"
              data-copy-prompt
              data-prompt={kindInstallPrompt}
              aria-live="polite"
            >
              Copy install prompt <span aria-hidden="true">↗</span>
            </button>
          </aside>
        </div>

        <figure class="plate hero-plate" data-hero>
          <div class="plate-nav" role="group" aria-label="Hero screenshots">
            <button type="button" data-hero-prev aria-label="Previous screenshot">‹</button>
            <span data-hero-count aria-hidden="true">01 / 04</span>
            <button type="button" data-hero-next aria-label="Next screenshot">›</button>
          </div>
          <div class="hero-slide" data-hero-slide>
            <div class="plate-stage">
              <video
                data-hero-video
                src="/screens/run-recording.mp4?v=1"
                poster="/screens/run-recording-poster.webp?v=1"
                width="2400"
                height="1506"
                muted
                playsinline
                preload="metadata"
                aria-label="View full screen: recording of one agent run — a prompt fans out to a subagent DAG, then the finished trace, replayed at 4x speed"
              ></video>
              <span class="video-progress" data-hero-progress aria-hidden="true"></span>
            </div>
            <div class="title-block">
              <div class="tb-sheet"><span class="tb-key">Sheet</span><span class="tb-val">01a — Recorded run</span></div>
              <div><span class="tb-key">Title</span><span class="tb-val">One run from prompt to trace</span></div>
              <div class="tb-scale"><span class="tb-key">Scale</span><span class="tb-val">4:1 — 2½ min of work in 39 s</span></div>
            </div>
          </div>
          <div class="hero-slide" data-hero-slide hidden>
            <div class="plate-stage">
              <img
                src="/screens/run-chat.webp?v=4"
                alt="Desktop run view with chat, steering, and a subagent dependency graph"
                width="3024"
                height="1898"
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="title-block">
              <div class="tb-sheet"><span class="tb-key">Sheet</span><span class="tb-val">01b — Desktop</span></div>
              <div><span class="tb-key">Title</span><span class="tb-val">Run view — chat, steering, subagent graph</span></div>
              <div class="tb-scale"><span class="tb-key">Drawn by</span><span class="tb-val">your agents</span></div>
            </div>
          </div>
          <div class="hero-slide" data-hero-slide hidden>
            <div class="plate-stage">
              <img
                class="hero-tablet-shot"
                src="/screens/tablet-1.webp?v=5"
                alt="iPad view of a live agent run delegating work to a subagent graph"
                width="2752"
                height="2064"
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="title-block">
              <div class="tb-sheet"><span class="tb-key">Sheet</span><span class="tb-val">01c — iPad</span></div>
              <div><span class="tb-key">Title</span><span class="tb-val">The same run, followed live from your iPad</span></div>
              <div class="tb-scale"><span class="tb-key">Status</span><span class="tb-val">compute stays in your cluster</span></div>
            </div>
          </div>
          <div class="hero-slide" data-hero-slide hidden>
            <div class="plate-stage">
              <img
                class="hero-tablet-shot"
                src="/screens/tablet-2.webp?v=5"
                alt="iPad view of the delegated task list for a live agent run"
                width="2752"
                height="2064"
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="title-block">
              <div class="tb-sheet"><span class="tb-key">Sheet</span><span class="tb-val">01d — iPad</span></div>
              <div><span class="tb-key">Title</span><span class="tb-val">Six delegated tasks, steered from anywhere</span></div>
              <div class="tb-scale"><span class="tb-key">Status</span><span class="tb-val">compute stays in your cluster</span></div>
            </div>
          </div>
        </figure>
      </div>

      <div class="legend" role="group" aria-label="Supported triggers and model providers">
        <div class="legend-row" aria-label="Supported triggers">
          <span class="legend-key">Triggers <small>work enters here</small></span>
          {triggers.map((trigger) => (
            <a class="legend-chip" href={trigger.href}>
              <span class="chip-tile"><Mark name={trigger.mark} size={19} /></span>
              <span>{trigger.name}</span>
            </a>
          ))}
        </div>
        <div class="legend-row" aria-label="Supported model providers">
          <span class="legend-key">Models <small>bring your own</small></span>
          {providers.map((provider) => (
            <a class="legend-chip" href="/docs/settings/credentials/">
              <span class="chip-tile"><Mark name={provider.mark} size={19} /></span>
              <span>{provider.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="story-section" aria-label="Product views">
      <div class="product-gallery" data-slides>
        <div class="gallery-tabs" role="tablist" aria-label="Product views">
          {slides.map((slide, index) => (
            <button
              class="gallery-tab"
              role="tab"
              id={`tab-${index}`}
              aria-controls={`slide-${index}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
            >
              <span>{slide.kind}</span>
              <b>{slide.title}</b>
            </button>
          ))}
        </div>
        <div class="gallery-stage">
          {slides.map((slide, index) => (
            <article class="gallery-slide" role="tabpanel" id={`slide-${index}`} aria-labelledby={`tab-${index}`} hidden={index !== 0}>
              {'shots' in slide ? (
                <div class="mobile-pair">
                  {slide.shots.map((shot) => (
                    <img src={shot} alt={slide.alt} width="2752" height="2064" loading="lazy" decoding="async" />
                  ))}
                </div>
              ) : (
                <img src={slide.shot} alt={slide.alt} width="3024" height="1898" loading="lazy" decoding="async" />
              )}
              <footer>
                <p>{slide.desc}</p>
                <a href={slide.href}>Open the guide <span aria-hidden="true">→</span></a>
              </footer>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Sheet 08: Why self-hosted -->
    <section class="why-section" aria-labelledby="why-title">
      <div class="why-inner">
        <header class="why-header">
          <p class="section-kicker">Sheet 08 · Principles</p>
          <h2 id="why-title">Why run coding agents in your own cluster?</h2>
          <p class="why-lead">Cloud agent harnesses are convenient, but they come with trade-offs that matter the moment your codebase has proprietary logic, private registries, or compliance requirements. Here is the case for keeping the compute yours.</p>
        </header>
        <div class="why-grid">
          <article class="why-card">
            <h3>Source code and prompts stay inside your network</h3>
            <p>When an agent runs in a cloud SaaS harness, your repository content, file diffs, and the natural-language prompts you write all travel to a third-party data centre. With GratefulAgents, every agent run executes inside a sandbox in your own Kubernetes cluster. The only outbound connections are the inference requests your agents make directly to the model provider whose API key you supply — and those requests go straight from your cluster to Anthropic, OpenAI, or whoever you choose.</p>
          </article>
          <article class="why-card">
            <h3>You own the model credentials — and the costs that come with them</h3>
            <p>GratefulAgents stores all credentials in your workspace. There is no credential relay through our servers. This also means you can use provider-negotiated pricing, API credits, or committed-spend agreements you have directly with Anthropic or OpenAI. You are not locked into a harness vendor's margin on top of the underlying inference cost.</p>
          </article>
          <article class="why-card">
            <h3>The harness itself is inspectable and auditable</h3>
            <p>GratefulAgents is <a href={repositoryUrl}>open source under AGPL-3.0</a>. You can read every line of the controller, the CRD logic, and the sandbox configuration. Combined with the per-run <a href="/docs/results/observability/">observability console</a> — which records every tool call, every LLM request, and every token — you always know what the agent did and why. A black-box harness cannot offer that. For a detailed comparison, see <a href="/alternatives/">alternatives to cloud coding agents</a>.</p>
          </article>
          <article class="why-card">
            <h3>Agent compute sits next to your private infrastructure</h3>
            <p>Agents frequently need to read internal packages, query private databases, or call APIs that are not reachable from the public internet. When the agent sandbox runs inside the same cluster (or the same VPC) as those resources, latency is low and no ingress rules or tunnels are required. You apply the same Kubernetes network policies, RBAC, and pod security standards you already use for the rest of your workloads. For on-premise or air-gapped environments, this is the only viable option.</p>
          </article>
        </div>
        <p class="why-links">
          Get started with the <a href="/docs/getting-started/self-hosting-kind/">Kind local demo</a> (macOS or Linux laptop, five minutes) or the <a href="/docs/getting-started/self-hosting-k3s/">k3s server install</a> for a persistent deployment. Read more about <a href="/self-hosted-coding-agents/">self-hosted coding agents</a> and what makes them different from cloud alternatives.
        </p>
      </div>
    </section>

    <!-- Sheet 09: Compared to cloud harnesses -->
    <section class="cmp-section" aria-labelledby="cmp-title">
      <div class="cmp-inner">
        <header class="why-header">
          <p class="section-kicker">Sheet 09 · Comparison</p>
          <h2 id="cmp-title">How GratefulAgents compares to cloud harnesses</h2>
          <p class="why-lead">Cloud products like GitHub Copilot's coding agent and Devin are more mature and have larger teams behind them. GratefulAgents is earlier-stage software that trades managed convenience for ownership and transparency. OpenHands is a fellow open-source project, but it occupies a different layer of the stack. <a href="/alternatives/">See the full alternatives guide →</a></p>
        </header>
        <div class="cmp-table-wrap" role="region" aria-label="Feature comparison table" tabindex="0">
          <table class="cmp-table">
            <thead>
              <tr>
                <th scope="col">Dimension</th>
                <th scope="col">GitHub Copilot agent</th>
                <th scope="col">Devin</th>
                <th scope="col">OpenHands</th>
                <th scope="col" class="cmp-ours">GratefulAgents</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Where code executes</th>
                <td>GitHub cloud</td>
                <td>Cognition cloud</td>
                <td>Your machine / server</td>
                <td class="cmp-ours">Your Kubernetes cluster</td>
              </tr>
              <tr>
                <th scope="row">Model credential ownership</th>
                <td>GitHub / Microsoft</td>
                <td>Cognition</td>
                <td>Yours (configurable)</td>
                <td class="cmp-ours">Yours — stored in your workspace</td>
              </tr>
              <tr>
                <th scope="row">Model choice</th>
                <td>Copilot-selected</td>
                <td>Proprietary</td>
                <td>Configurable</td>
                <td class="cmp-ours">Claude, OpenAI, OpenRouter, Grok, Copilot</td>
              </tr>
              <tr>
                <th scope="row">Trigger surface</th>
                <td>GitHub issues / PRs</td>
                <td>Web UI, Slack</td>
                <td>Web UI</td>
                <td class="cmp-ours">GitHub, Linear, Slack, cron, web, desktop, mobile</td>
              </tr>
              <tr>
                <th scope="row">Run observability</th>
                <td>Basic logs</td>
                <td>Replay UI</td>
                <td>Minimal</td>
                <td class="cmp-ours"><a href="/docs/results/observability/">Cost, tokens, traces, subagent graphs, errors</a></td>
              </tr>
              <tr>
                <th scope="row">Client surface</th>
                <td>GitHub web</td>
                <td>Web, Slack</td>
                <td>Web UI</td>
                <td class="cmp-ours">Web, desktop (macOS, Linux), iOS, Android</td>
              </tr>
              <tr>
                <th scope="row">Trigger integrations</th>
                <td>GitHub only</td>
                <td>Slack, web</td>
                <td>None built-in</td>
                <td class="cmp-ours"><a href="/docs/integrations/github/">GitHub</a>, Linear, Slack, cron</td>
              </tr>
              <tr>
                <th scope="row">Licence</th>
                <td>Proprietary SaaS</td>
                <td>Proprietary SaaS</td>
                <td>MIT</td>
                <td class="cmp-ours">AGPL-3.0</td>
              </tr>
              <tr>
                <th scope="row">Maturity</th>
                <td>GA</td>
                <td>GA</td>
                <td>Active / stable</td>
                <td class="cmp-ours">Early development — expect bugs</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="cmp-note">Cloud products are evaluated on publicly available information and may have changed. For a full analysis see <a href="/alternatives/">the alternatives guide</a>.</p>
      </div>
    </section>

    <!-- Sheet 10: FAQ -->
    <section class="faq-section" aria-labelledby="faq-title">
      <div class="faq-inner">
        <header class="why-header">
          <p class="section-kicker">Sheet 10 · Field notes</p>
          <h2 id="faq-title">Frequently asked questions</h2>
        </header>
        <div class="faq-list">
          {faqItems.map((item) => (
            <details class="faq-item">
              <summary class="faq-q">{item.q}</summary>
              <div class="faq-a"><p>{item.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="guide-section" aria-labelledby="guide-title">
      <header class="section-heading compact">
        <p class="section-kicker">Index of sheets · the field manual</p>
        <h2 id="guide-title">Go from first run to full control.</h2>
        <p>The docs ship from the same repository as the platform. Read them here; improve them on GitHub.</p>
      </header>
      <div class="station-grid">
        {stations.map((station) => (
          <a class="station" href={station.href}>
            <span>{station.kind}</span>
            <h3>{station.title}</h3>
            <p>{station.desc}</p>
            <i aria-hidden="true">→</i>
          </a>
        ))}
      </div>
    </section>

    <section class="closing-cta" aria-label="Get started">
      <div class="closing-main">
        <div>
          <p class="stamp">Issued for construction</p>
          <h2>Your agents.<br /><span>Your compute.</span></h2>
        </div>
        <div class="closing-side">
          <p>Own the runtime, choose the models, and see the work. Start with the local Kind demo.</p>
          <div class="cta-row">
            <a class="btn btn-primary" href={kindGuidePath}>Run the Kind demo <span aria-hidden="true">→</span></a>
            <a class="btn btn-quiet" href={repositoryUrl}>Star on GitHub <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
      <div class="title-block closing-block">
        <div class="tb-sheet"><span class="tb-key">Sheet</span><span class="tb-val">07 — closeout</span></div>
        <div><span class="tb-key">Project</span><span class="tb-val">gratefulagents</span></div>
        <div><span class="tb-key">License</span><span class="tb-val">AGPL-3.0</span></div>
        <div><span class="tb-key">Runtime</span><span class="tb-val">your cluster</span></div>
        <div><span class="tb-key">Clients</span><span class="tb-val">Web · Desktop · iOS · Android</span></div>
        <div><span class="tb-key">Drawn by</span><span class="tb-val">your agents</span></div>
      </div>
    </section>
  </main>

  <div class="lightbox" data-lightbox hidden>
    <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close full screen image">Close ✕</button>
    <img src="" alt="" data-lightbox-img />
  </div>
</Base>

<script>
  const copyBtn = document.querySelector('[data-copy-prompt]');
  copyBtn?.addEventListener('click', async () => {
    const text = copyBtn instanceof HTMLElement ? copyBtn.dataset.prompt?.trim() : undefined;
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      copyBtn.textContent = 'Prompt copied ✓';
      setTimeout(() => { copyBtn.innerHTML = 'Copy install prompt <span aria-hidden="true">↗</span>'; }, 1800);
    } catch {
      copyBtn.textContent = 'Copy unavailable — open the guide';
    }
  });

  // Lightbox: click any product screenshot to view it full screen.
  const lightbox = document.querySelector('[data-lightbox]');
  if (lightbox instanceof HTMLElement) {
    const lightboxImg = lightbox.querySelector('[data-lightbox-img]');
    let lastFocus = null;

    const close = () => {
      lightbox.hidden = true;
      document.body.style.overflow = '';
      if (lastFocus instanceof HTMLElement) lastFocus.focus();
    };
    const open = (img) => {
      lastFocus = document.activeElement;
      lightboxImg.src = img.currentSrc || img.src;
      lightboxImg.alt = img.alt;
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      lightbox.querySelector('[data-lightbox-close]')?.focus();
    };

    document.querySelectorAll('main img[src^="/screens/"]').forEach((img) => {
      img.classList.add('zoomable');
      img.setAttribute('tabindex', '0');
      img.setAttribute('role', 'button');
      img.setAttribute('aria-label', `View full screen: ${img.alt}`);
      img.addEventListener('click', () => open(img));
      img.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          open(img);
        }
      });
    });

    lightbox.addEventListener('click', close);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !lightbox.hidden) close();
    });
  }

  const hero = document.querySelector('[data-hero]');
  if (hero) {
    const slides = [...hero.querySelectorAll('[data-hero-slide]')];
    const count = hero.querySelector('[data-hero-count]');
    const video = hero.querySelector('[data-hero-video]');
    const progress = hero.querySelector('[data-hero-progress]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer;
    let manual = false;
    let hovered = false;

    // Reduced motion: no autoplay, no rotation — hand the recording over
    // to the native controls instead.
    if (video && reduceMotion) video.controls = true;

    const onVideoSlide = () => Boolean(video && slides[current].contains(video));
    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } };
    const start = () => {
      // The video slide advances itself when playback ends.
      if (reduceMotion || manual || hovered || timer || onVideoSlide()) return;
      timer = setInterval(() => show(current + 1), 5000);
    };

    const show = (index) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => { slide.hidden = i !== current; });
      if (count) count.textContent = `0${current + 1} / 0${slides.length}`;
      stop();
      if (video) {
        if (onVideoSlide() && !reduceMotion) {
          video.currentTime = 0;
          video.play().catch(() => {});
        } else if (!onVideoSlide()) {
          video.pause();
        }
      }
      start();
    };

    if (video) {
      video.addEventListener('ended', () => {
        if (!manual && !hovered && onVideoSlide()) show(current + 1);
      });
      video.addEventListener('timeupdate', () => {
        if (progress && video.duration) {
          progress.style.transform = `scaleX(${video.currentTime / video.duration})`;
        }
      });
      if (!reduceMotion) {
        // Click (or Enter/Space) opens the recording full screen, mirroring
        // the screenshot lightbox; native controls take over while there.
        const goFullscreen = () => {
          if (document.fullscreenElement) return;
          if (video.requestFullscreen) video.requestFullscreen().catch(() => {});
          else if (video.webkitRequestFullscreen) video.webkitRequestFullscreen();
          else if (video.webkitEnterFullscreen) video.webkitEnterFullscreen();
        };
        video.setAttribute('tabindex', '0');
        video.setAttribute('role', 'button');
        video.addEventListener('click', goFullscreen);
        video.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            goFullscreen();
          }
        });
        for (const type of ['fullscreenchange', 'webkitfullscreenchange']) {
          document.addEventListener(type, () => {
            video.controls = (document.fullscreenElement || document.webkitFullscreenElement) === video;
          });
        }
      }
    }

    hero.querySelector('[data-hero-prev]')?.addEventListener('click', () => { manual = true; show(current - 1); });
    hero.querySelector('[data-hero-next]')?.addEventListener('click', () => { manual = true; show(current + 1); });
    hero.addEventListener('pointerenter', () => { hovered = true; stop(); });
    hero.addEventListener('pointerleave', () => { hovered = false; start(); });

    show(0);
  }

  const gallery = document.querySelector('[data-slides]');
  if (gallery) {
    const tabs = [...gallery.querySelectorAll('.gallery-tab')];
    const slides = [...gallery.querySelectorAll('.gallery-slide')];
    let current = 0;

    const show = (index) => {
      current = (index + tabs.length) % tabs.length;
      tabs.forEach((tab, tabIndex) => {
        tab.setAttribute('aria-selected', String(tabIndex === current));
        tab.tabIndex = tabIndex === current ? 0 : -1;
      });
      slides.forEach((slide, slideIndex) => {
        slide.hidden = slideIndex !== current;
      });
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => show(index));
      tab.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          show(current + 1);
          tabs[current].focus();
        }
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          show(current - 1);
          tabs[current].focus();
        }
      });
    });
  }
</script>
