---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import {repositoryUrl} from '../data/sidebar';
import {homepageFaq} from '../data/faq';
import {useCases} from '../data/usecases';
import type {MarkName} from '../data/marks';

const triggers: {mark: MarkName; name: string; href: string}[] = [
  {mark: 'github', name: 'GitHub', href: '/docs/integrations/github/'},
  {mark: 'linear', name: 'Linear', href: '/docs/integrations/linear/'},
  {mark: 'slack', name: 'Slack', href: '/docs/integrations/slack/'},
  {mark: 'cron', name: 'Schedules', href: '/docs/projects/cron/'},
];

const providers: {mark: MarkName; name: string}[] = [
  {mark: 'anthropic', name: 'Claude'},
  {mark: 'openai', name: 'OpenAI'},
  {mark: 'openrouter', name: 'OpenRouter'},
  {mark: 'xai', name: 'Grok'},
  {mark: 'copilot', name: 'Copilot'},
];

const stages = [
  {
    key: 'Trigger',
    title: 'Work arrives from where it already lives',
    body: 'A GitHub issue, a pull request review comment, a Linear ticket, a Slack message, or a cron schedule starts a run using the defaults saved on your project.',
  },
  {
    key: 'Execute',
    title: 'The agent works in an isolated sandbox',
    body: 'Each run gets its own sandbox workload in your cluster, with the repository, runtime profile, skills, and MCP servers you allowed. Nothing else.',
  },
  {
    key: 'Review',
    title: 'You get a diff, a pull request, and a trace',
    body: 'Follow activity as it happens, steer or stop the agent mid-run, then review the diff, the pull request, and the full trace before anything merges.',
  },
];

const views = [
  {
    id: 'operate',
    tab: 'Agent Ops',
    title: 'Every run on one board',
    body: 'Live work, blockers, cost, and recent outcomes across the workspace. Step in only when a run actually needs you.',
    href: '/docs/runs/review-activity/',
    shot: '/screens/agent-ops-detail.webp?v=1',
    alt: 'Agent Ops board listing live runs with state, mode, latest activity, cost, and age columns',
  },
  {
    id: 'measure',
    tab: 'Observability',
    title: 'Reliability across runs and models',
    body: 'Compare cost, tokens, tool calls, subagents, compactions, and errors over time, broken down by model.',
    href: '/docs/results/observability/',
    shot: '/screens/observability-detail.webp?v=1',
    alt: 'Observability dashboard showing generation spend, run cost, tokens, tool calls, subagents, reliability, and model breakdowns',
  },
  {
    id: 'orchestrate',
    tab: 'Subagents',
    title: 'Fan work out, keep the thread',
    body: 'A run can delegate to specialist subagents. The dependency graph shows what is running, what is blocked, and what finished.',
    href: '/docs/runs/review-activity/',
    shot: '/screens/graph-detail.webp?v=1',
    alt: 'Subagent graph view showing a root run spawning writer and explore subagents with live status',
  },
  {
    id: 'inspect',
    tab: 'Traces',
    title: 'Every turn has a trace',
    body: 'Open timing, tool calls, token usage, cost, and errors for any turn of any run. The harness never becomes a black box.',
    href: '/docs/runs/meta-harness-traces/',
    shot: '/screens/trace-detail.webp?v=1',
    alt: 'Trace timeline of a run showing per-turn LLM calls, WebFetch tool spans, durations, and costs',
  },
];

const installPrompt =
  'Read https://gratefulagents.dev/docs/getting-started/self-hosting-kind/ and install gratefulagents on my laptop with Kind. Verify Docker and the other prerequisites first, run the installer, then give me the URL and the credentials I need to sign in.';

const homepageDescription =
  'Open-source control plane for AI coding agents on Kubernetes. Self-host the runtime, bring your own model keys, and inspect the cost and trace of every run.';

const structuredData = [
  {
    '@type': 'SoftwareApplication',
    '@id': 'https://gratefulagents.dev/#software',
    name: 'GratefulAgents',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Kubernetes, Web, macOS, Windows, Linux, iOS, Android',
    url: 'https://gratefulagents.dev/',
    description: homepageDescription,
    codeRepository: repositoryUrl,
    license: 'https://www.gnu.org/licenses/agpl-3.0.html',
    isAccessibleForFree: true,
    offers: {'@type': 'Offer', price: '0', priceCurrency: 'USD'},
    featureList: [
      'Self-hosted coding agent execution on Kubernetes',
      'GitHub, Linear, Slack, and scheduled triggers',
      'Bring-your-own model provider credentials',
      'Run traces, cost, token, and reliability observability',
      'Web, desktop, iOS, and Android clients',
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': 'https://gratefulagents.dev/#faq',
    mainEntity: homepageFaq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {'@type': 'Answer', text: item.a},
    })),
  },
];
---

<Base
  title="Self-Hosted AI Coding Agents on Kubernetes | GratefulAgents"
  description={homepageDescription}
  {structuredData}
  bodyClass="is-home"
>
  <main id="main">
    <!-- Hero: asymmetric split, claim on the left, the product actually running on the right. -->
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span class="live"></span> Open source · Kubernetes native</p>
          <h1 id="hero-title">Coding agents that run inside your cluster</h1>
          <p class="hero-sub">
            An open-source control plane for AI coding agents on Kubernetes. Your cluster, your
            model keys, every run inspectable.
          </p>
          <div class="btn-row">
            <a class="btn btn-primary" href="#install">Install locally</a>
            <a class="btn btn-ghost" href={repositoryUrl} rel="noopener">View source</a>
          </div>
        </div>

        <figure class="hero-media">
          <video
            data-hero-video
            src="/screens/run-recording.mp4?v=1"
            poster="/screens/run-recording-poster.webp?v=1"
            width="2400"
            height="1506"
            muted
            loop
            playsinline
            preload="none"
            aria-label="Recording of one agent run: a prompt fans out to a subagent graph, then finishes with a trace"
          ></video>
          <figcaption>
            <b><span class="live" aria-hidden="true"></span> One run, prompt to trace</b>
            <span>replayed at 4x</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Compatibility rail: what starts a run, and what answers it. -->
    <section class="rail" aria-label="Supported triggers and model providers">
      <div class="wrap rail-inner">
        <div class="rail-group">
          <h2>Runs start from</h2>
          <ul class="rail-set">
            {
              triggers.map((item) => (
                <li>
                  <a href={item.href}>
                    <Mark name={item.mark} size={16} />
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rail-split" aria-hidden="true"></div>
        <div class="rail-group">
          <h2>Models you connect</h2>
          <ul class="rail-set">
            {
              providers.map((item) => (
                <li>
                  <span>
                    <Mark name={item.mark} size={16} />
                    {item.name}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Install: terminal panel, the fastest possible proof. -->
    <section class="section" id="install">
      <div class="wrap install-grid">
        <div class="install-copy reveal">
          <h2>Clone, run one command, sign in</h2>
          <p class="lede">
            Kind gives you the whole platform on a laptop for evaluation. k3s is the supported
            path for a server you keep.
          </p>
          <div class="install-note">
            <strong>Or hand it to the agent you already use.</strong>
            <p>
              Copy a prompt that points your coding agent at the install guide and let it check
              prerequisites, run the installer, and hand back the URL.
            </p>
            <div class="btn-row">
              <button type="button" class="copy-btn" data-copy={installPrompt} data-label="Copy install prompt">
                Copy install prompt
              </button>
            </div>
          </div>
        </div>

        <div class="term" data-term>
          <div class="term-tabs" role="tablist" aria-label="Install paths">
            <button
              type="button"
              class="term-tab"
              role="tab"
              id="tab-kind"
              aria-controls="panel-kind"
              aria-selected="true"
            >kind</button>
            <button
              type="button"
              class="term-tab"
              role="tab"
              id="tab-k3s"
              aria-controls="panel-k3s"
              aria-selected="false"
              tabindex="-1"
            >k3s</button>
          </div>

          <div class="term-body" id="panel-kind" role="tabpanel" aria-labelledby="tab-kind">
            <div class="c"># macOS or Linux laptop with Docker</div>
            <div><span class="p">$</span> git clone https://github.com/gratefulagents/gratefulagents.git</div>
            <div><span class="p">$</span> cd gratefulagents</div>
            <div><span class="p">$</span> make kind-install</div>
            <div class="c"># prints the local dashboard URL and admin password</div>
          </div>

          <div class="term-body" id="panel-k3s" role="tabpanel" aria-labelledby="tab-k3s" hidden>
            <div class="c"># fresh Debian or Ubuntu server, needs sudo</div>
            <div><span class="p">$</span> git clone https://github.com/gratefulagents/gratefulagents.git</div>
            <div><span class="p">$</span> cd gratefulagents</div>
            <div><span class="p">$</span> make k3s-install</div>
            <div class="c"># deploys the latest release images and chart</div>
          </div>

          <div class="term-foot">
            <span class="meta">Installs the latest published release</span>
            <a class="textlink" href="/docs/getting-started/self-hosting-kind/">Read the install guide</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Pipeline: how one run actually moves. -->
    <section class="section">
      <div class="wrap">
        <div class="section-head reveal">
          <h2>How a run happens</h2>
          <p>
            The same path whether a human starts it, a webhook starts it, or a schedule does.
          </p>
        </div>
        <div class="pipeline">
          {
            stages.map((stage) => (
              <article class="stage">
                <p class="stage-key">{stage.key}</p>
                <h3>{stage.title}</h3>
                <p>{stage.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Gallery: the product, one view at a time, on user input only. -->
    <section class="section" id="views">
      <div class="wrap" data-gallery>
        <div class="gallery-head reveal">
          <h2>Look at the work, not just the output</h2>
          <div class="gallery-tabs" role="tablist" aria-label="Product views">
            {
              views.map((view, index) => (
                <button
                  type="button"
                  class="gallery-tab"
                  role="tab"
                  id={`tab-${view.id}`}
                  aria-controls={`panel-${view.id}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? 0 : -1}
                >
                  {view.tab}
                </button>
              ))
            }
          </div>
        </div>

        {
          views.map((view, index) => (
            <div
              class="gallery-panel"
              role="tabpanel"
              id={`panel-${view.id}`}
              aria-labelledby={`tab-${view.id}`}
              hidden={index !== 0}
            >
              <div class="gallery-text">
                <h3>{view.title}</h3>
                <p>{view.body}</p>
                <a class="textlink" href={view.href}>
                  Read the guide <span aria-hidden="true">→</span>
                </a>
              </div>
              <div class="gallery-shot">
                <img
                  src={view.shot}
                  alt={view.alt}
                  width="2200"
                  height="1375"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Bento: the control surface, sized by how much each part matters. -->
    <section class="section" id="capabilities">
      <div class="wrap">
        <div class="section-head reveal">
          <h2>Control you do not have to build yourself</h2>
          <p>
            The parts of an agent platform that are tedious to get right are the parts that ship
            in the box.
          </p>
        </div>
        <div class="bento">
          <article class="cell cell-wide">
            <div>
              <h3>Steer the run while it is working</h3>
              <p>
                Chat with the agent mid-run, change between plan, autopilot, and stop, and correct
                course before it spends another hour going the wrong way.
              </p>
            </div>
            <div class="cell-shot">
              <img
                src="/screens/run-chat-detail.webp?v=1"
                alt="Run view showing the agent conversation, run state chips, and delegated task activity"
                width="1400"
                height="788"
                loading="lazy"
                decoding="async"
              />
            </div>
          </article>

          <article class="cell cell-accent">
            <h3>Bring your own model keys</h3>
            <p>
              Credentials are configured per user, per workspace. Switch providers without
              changing how runs are defined.
            </p>
            <div class="cell-marks">
              {providers.map((item) => <Mark name={item.mark} size={20} />)}
            </div>
          </article>

          <article class="cell">
            <h3>Isolated by construction</h3>
            <p>
              Runs execute as sandbox workloads built on kubernetes-sigs/agent-sandbox, scoped to
              the repository and runtime profile you allowed.
            </p>
            <ul class="cell-chips">
              <li>agent-sandbox</li>
              <li>runtime profiles</li>
              <li>MCP policies</li>
              <li>guardrails</li>
            </ul>
            <a class="textlink" href="/docs/settings/resources/">Runtime profiles →</a>
          </article>

          <article class="cell">
            <h3>Reusable building blocks</h3>
            <p>
              Configure an agent capability once as a workspace resource, then reuse it across
              every project instead of copying it into each run.
            </p>
            <ul class="cell-chips">
              <li>skills</li>
              <li>MCP servers</li>
              <li>modes</li>
              <li>roles</li>
              <li>policies</li>
            </ul>
            <a class="textlink" href="/docs/settings/skill-packages/">Skills and MCP →</a>
          </article>

          <article class="cell">
            <h3>The run follows you</h3>
            <p>Review and steer from iOS or Android while the compute stays in your cluster.</p>
            <a class="textlink" href="/docs/getting-started/web-desktop-workspaces/">Clients →</a>
            <div class="cell-shot">
              <img
                src="/screens/tablet-1-detail.webp?v=1"
                alt="Tablet view of the gratefulagents app following a live agent run"
                width="1400"
                height="933"
                loading="lazy"
                decoding="async"
              />
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Use cases: index list into the deeper pages. -->
    <section class="section" id="use-cases">
      <div class="wrap">
        <div class="section-head reveal">
          <h2>What teams point it at</h2>
        </div>
        <div class="uses">
          {
            useCases.map((useCase) => (
              <a class="use" href={`/use-cases/${useCase.slug}/`}>
                <h3>
                  {useCase.title.split(' for ')[0]} <i aria-hidden="true">→</i>
                </h3>
                <p>{useCase.summary}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ: disclosure list, mirrored into FAQPage structured data. -->
    <section class="section" id="faq">
      <div class="wrap faq-split">
        <div class="faq-aside reveal">
          <h2>Questions people ask first</h2>
          <p>
            The honest answers, including the ones about what this project does not do yet.
          </p>
          <a class="textlink" href="/faq/">All questions <span aria-hidden="true">&#8594;</span></a>
        </div>
        <div class="faq">
          {
            homepageFaq.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Closing statement. -->
    <section class="closer">
      <div class="wrap closer-inner">
        <h2>Put it on a cluster you already trust</h2>
        <p>
          One clone and one command. Nothing leaves your infrastructure except the model calls you
          configure yourself.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="#install">Install locally</a>
          <a class="btn btn-ghost" href="/docs/getting-started/quick-start/">Read the quick start</a>
        </div>
      </div>
    </section>
  </main>

  <div class="lightbox" hidden data-lightbox>
    <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close">✕</button>
    <img src="" alt="" data-lightbox-img />
  </div>
</Base>

<script>
  // --- Hero recording -------------------------------------------------------
  // Motivated: the fastest honest proof that the product exists. It only plays
  // when it is on screen, never under reduced motion, and never blocks paint.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      video.controls = true;
      video.preload = 'metadata';
    } else if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) video.play().catch(() => {});
            else video.pause();
          });
        },
        {threshold: 0.35},
      );
      io.observe(video);
    }
  }

  // --- Generic roving tablist ----------------------------------------------
  const wireTabs = (root: Element | null, tabSelector: string) => {
    if (!root) return;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>(tabSelector)];
    if (!tabs.length) return;
    const panels = tabs.map((tab) =>
      document.getElementById(tab.getAttribute('aria-controls') ?? ''),
    );
    let current = 0;
    const show = (next: number) => {
      current = (next + tabs.length) % tabs.length;
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === current));
        tab.tabIndex = i === current ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        if (panel) panel.hidden = i !== current;
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => show(i));
      tab.addEventListener('keydown', (event) => {
        const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        show(current + step);
        tabs[current].focus();
      });
    });
    show(0);
  };

  wireTabs(document.querySelector('[data-term]'), '.term-tab');
  wireTabs(document.querySelector('[data-gallery]'), '.gallery-tab');

  // --- Screenshot lightbox --------------------------------------------------
  const lightbox = document.querySelector<HTMLElement>('[data-lightbox]');
  const lightboxImg = lightbox?.querySelector<HTMLImageElement>('[data-lightbox-img]');
  if (lightbox && lightboxImg) {
    let opener: HTMLElement | null = null;
    const close = () => {
      lightbox.hidden = true;
      document.body.style.overflow = '';
      opener?.focus();
    };
    const open = (img: HTMLImageElement) => {
      opener = img;
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      lightbox.querySelector<HTMLButtonElement>('[data-lightbox-close]')?.focus();
    };

    document.querySelectorAll<HTMLImageElement>('main img[src^="/screens/"]').forEach((img) => {
      img.classList.add('zoomable');
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.setAttribute('aria-label', `View full size: ${img.alt}`);
      img.addEventListener('click', () => open(img));
      img.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        open(img);
      });
    });

    lightbox.addEventListener('click', close);
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !lightbox.hidden) close();
    });
  }
</script>
