---
import Base from '../layouts/Base.astro';
import '../styles/marketing.css';
import {differenceRows, faqs} from '../data/differences';

const title = 'GratefulAgents vs Devin, Copilot, and Laptop Agents';
const description =
  'How GratefulAgents compares with coding agent CLIs, Devin, and the GitHub Copilot coding agent: where runs execute, who holds the keys, and how it scales.';

const structuredData = [
  {
    '@type': 'WebPage',
    '@id': 'https://gratefulagents.dev/differences/#webpage',
    name: title,
    description,
    url: 'https://gratefulagents.dev/differences/',
    author: {'@type': 'Organization', '@id': 'https://gratefulagents.dev/#organization'},
  },
  {
    '@type': 'BreadcrumbList',
    '@id': 'https://gratefulagents.dev/differences/#breadcrumb',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://gratefulagents.dev/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Compare',
        item: 'https://gratefulagents.dev/differences/',
      },
    ],
  },
  {
    '@type': 'FAQPage',
    '@id': 'https://gratefulagents.dev/differences/#faq',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {'@type': 'Answer', text: f.answer},
    })),
  },
];
---

<Base {title} {description} {structuredData}>
  <main id="main">
    <div class="mk-page">

      <nav aria-label="Breadcrumb">
        <ol class="mk-breadcrumb">
          <li><a href="/">Home</a></li>
          <li><span aria-current="page">Compare</span></li>
        </ol>
      </nav>

      <div class="mk-hero">
        <h1>GratefulAgents compared with laptop agents, Devin, and Copilot</h1>
        <p>
          A coding agent CLI on your laptop is quick to start but stops when you do. Devin and the
          GitHub Copilot coding agent keep running, but on the vendor's machines with the vendor's
          keys. GratefulAgents keeps running <strong>on infrastructure you control</strong>, as
          many runs at once as you give it room for.
        </p>
        <div class="cta-row">
          <a href="/docs/getting-started/self-hosting-k3s/" class="btn btn-primary">Deploy to a server</a>
          <a href="/self-hosted-coding-agents/" class="text-link">Why teams self-host</a>
        </div>
      </div>

      <article class="mk-prose mk-prose-wide">
        <h2>Side by side</h2>
        <p>
          These rows stick to architecture: where things run and who holds what. Features change
          every month; where your code goes doesn't.
        </p>

        <div class="mk-table-scroll" role="region" aria-label="Architectural differences" tabindex="0">
          <table class="mk-compare-table">
            <thead>
              <tr>
                <th scope="col"><span class="sr-only">Dimension</span></th>
                <th scope="col">CLI agent on a laptop</th>
                <th scope="col">Devin</th>
                <th scope="col">Copilot coding agent</th>
                <th scope="col">GratefulAgents</th>
              </tr>
            </thead>
            <tbody>
              {differenceRows.map((row) => (
                <tr>
                  <td>{row.dimension}</td>
                  <td>{row.laptop}</td>
                  <td>{row.devin}</td>
                  <td>{row.copilot}</td>
                  <td>{row.gratefulagents}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mk-callout">
          <p>
            <strong>Fair warning.</strong> GratefulAgents is in early development. It works for
            evaluation and internal team use, but expect bugs and breaking changes between releases.
            High availability, managed hosting, and a support SLA are not offered.
          </p>
        </div>

        <h2>Questions</h2>
        <div class="mk-faq">
          {faqs.map((f) => (
            <details class="mk-faq-item">
              <summary>{f.question}</summary>
              <div class="mk-faq-answer">{f.answer}</div>
            </details>
          ))}
        </div>

        <p>
          The longer argument, including what running it yourself costs in effort, is on
          <a href="/self-hosted-coding-agents/">why teams self-host</a>. To try it, the
          <a href="/docs/getting-started/self-hosting-k3s/">server guide</a> takes about fifteen
          minutes, and the <a href="/docs/getting-started/self-hosting-kind/">Kind guide</a> runs it
          on a laptop.
        </p>
      </article>

      <div class="mk-disclaimer">
        <p>
          Devin® is a trademark of Cognition AI, Inc. GitHub® and GitHub Copilot® are trademarks of
          GitHub, Inc. All trademarks are the property of their respective owners. This page
          describes the authors' understanding of each product at time of writing; capabilities
          change frequently. Consult each vendor's own documentation for authoritative information.
        </p>
      </div>

    </div>
  </main>
</Base>

<style>
  .mk-prose-wide { max-width: none; }
  .mk-prose-wide > p, .mk-prose-wide > .mk-callout, .mk-prose-wide > .mk-faq, .mk-prose-wide > h2 { max-width: 46rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
