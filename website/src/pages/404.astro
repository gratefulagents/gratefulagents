---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found | GratefulAgents"
  description="The page you asked for isn't here. Try the GratefulAgents user guide, the server install guide, or the home page."
  noindex={true}
>
  <main id="main" class="notfound-main">
    <p class="section-kicker">404</p>
    <h1>Nothing at this address.</h1>
    <p class="notfound-lead">
      The page may have moved when the docs were reorganised. These are the places most people
      are looking for.
    </p>
    <ul class="notfound-links">
      <li><a href="/docs/">User guide</a></li>
      <li><a href="/docs/getting-started/self-hosting-k3s/">Install on a server</a></li>
      <li><a href="/docs/getting-started/self-hosting-kind/">Try it on a laptop</a></li>
      <li><a href="/docs/troubleshooting/common-issues/">Troubleshooting</a></li>
      <li><a href="/">Home</a></li>
    </ul>
  </main>
</Base>

<style>
  .notfound-main {
    width: min(100% - 2 * var(--gutter), 44rem);
    min-height: calc(100svh - var(--topbar-h) - 14rem);
    margin: 0 auto;
    padding: clamp(3rem, 12vh, 7rem) 0;
  }
  .notfound-main h1 {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 6vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .notfound-lead { margin: 0 0 2rem; color: var(--ink-2); font-size: 1.1rem; }
  .notfound-links { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--ink); }
  .notfound-links li { border-bottom: 1px solid var(--rule); }
  .notfound-links a { display: block; padding: 0.8rem 0; font-weight: 500; text-decoration: none; }
  .notfound-links a:hover { color: var(--accent-ink); }
</style>
