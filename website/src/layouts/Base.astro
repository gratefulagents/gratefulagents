---
import '../styles/global.css';
import {repositoryUrl} from '../data/sidebar';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  bodyClass = '',
  image = '/og-default.png',
  imageAlt = 'GratefulAgents: coding agents that run inside your own Kubernetes cluster',
  imageWidth = 1200,
  imageHeight = 630,
  imageType = 'image/png',
  type = 'website',
  noindex = false,
  structuredData = [],
} = Astro.props;

const nav = [
  {href: '/docs/', label: 'Docs', optional: false},
  {href: '/use-cases/', label: 'Use cases', optional: true},
  {href: '/faq/', label: 'FAQ', optional: true},
];

const current = Astro.url.pathname;
const siteUrl = Astro.site ?? Astro.url;
const abs = (p: string) => new URL(p, siteUrl).toString();
const canonical = abs(Astro.url.pathname);
const socialImage = abs(image);
const organizationId = abs('/#organization');
const websiteId = abs('/#website');
const pageStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'GratefulAgents',
      url: abs('/'),
      logo: abs('/logo.png'),
      description:
        'Open-source, self-hostable control plane for running AI coding agents on Kubernetes.',
      sameAs: [repositoryUrl],
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: 'GratefulAgents',
      url: abs('/'),
      inLanguage: 'en',
      publisher: {'@id': organizationId},
    },
    ...pageStructuredData,
  ],
};
// Prevent trusted page copy from prematurely closing the JSON-LD script element.
const serializedSchema = JSON.stringify(schema).replace(/</g, '\\u003c');

const footerCols = [
  {
    title: 'Get started',
    links: [
      {label: 'Quick start', href: '/docs/getting-started/quick-start/'},
      {label: 'Self-host on Kind', href: '/docs/getting-started/self-hosting-kind/'},
      {label: 'Self-host on k3s', href: '/docs/getting-started/self-hosting-k3s/'},
      {label: 'Web and desktop clients', href: '/docs/getting-started/web-desktop-workspaces/'},
    ],
  },
  {
    title: 'Use cases',
    links: [
      {label: 'Self-hosted coding agents', href: '/use-cases/self-hosted-coding-agents/'},
      {label: 'GitHub issue automation', href: '/use-cases/github-issue-automation/'},
      {label: 'Scheduled maintenance', href: '/use-cases/scheduled-agent-maintenance/'},
      {label: 'Agent observability', href: '/use-cases/agent-observability/'},
    ],
  },
  {
    title: 'Project',
    links: [
      {label: 'Source on GitHub', href: repositoryUrl},
      {label: 'Releases', href: `${repositoryUrl}/releases`},
      {label: 'Report an issue', href: `${repositoryUrl}/issues`},
      {label: 'Security policy', href: `${repositoryUrl}/security/policy`},
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="GratefulAgents" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="theme-color" content="#08090b" />

    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <script type="application/ld+json" set:html={serializedSchema} />
    <script is:inline>
      // Enables the scroll-reveal styles only when scripting is available, so
      // content is never hidden behind JS that failed to load.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="topbar">
      <div class="topbar-inner">
      <a class="brand" href="/">
        <img src="/logo.png" alt="" width="24" height="24" />
        <span>grateful<em>agents</em></span>
      </a>
      <nav class="topnav" aria-label="Primary">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class={item.optional ? 'nav-optional' : undefined}
              aria-current={current.startsWith(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <a href={repositoryUrl} class="gh" rel="noopener">GitHub</a>
      </nav>
      </div>
    </header>
    <slot />
    <footer class="site-foot">
      <div class="wrap">
        <div class="foot-inner">
          <div class="foot-brand">
            <a class="brand" href="/">
              <img src="/logo.png" alt="" width="24" height="24" />
              <span>grateful<em>agents</em></span>
            </a>
            <p>
              An open-source control plane for running AI coding agents inside your own
              Kubernetes cluster.
            </p>
            <p class="meta">AGPL-3.0 · early development</p>
          </div>
          {
            footerCols.map((col) => (
              <nav class="foot-col" aria-label={col.title}>
                <h2>{col.title}</h2>
                <ul>
                  {col.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            ))
          }
        </div>
        <div class="foot-bar">
          <span>© {new Date().getFullYear()} GratefulAgents contributors</span>
          <span>
            <a href={`${repositoryUrl}/tree/main/user-docs`}>Docs source</a>
          </span>
        </div>
      </div>
    </footer>
    <script>
      // Reveal-on-scroll for section headings. IntersectionObserver only, so
      // there is no scroll listener on the main thread, and content is visible
      // by default if this script never runs.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            });
          },
          {rootMargin: '0px 0px 8% 0px', threshold: 0.05},
        );
        targets.forEach((el) => io.observe(el));
      }

      // Shared copy-to-clipboard for any [data-copy] button.
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
        const label = button.dataset.label ?? button.textContent ?? 'Copy';
        button.addEventListener('click', async () => {
          const source = button.dataset.copy ?? '';
          const text = source.startsWith('#')
            ? (document.querySelector(source)?.textContent ?? '').trim()
            : source;
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = 'Copied';
          } catch {
            button.textContent = 'Copy failed, select manually';
          }
          window.setTimeout(() => {
            button.textContent = label;
          }, 1800);
        });
      });
    </script>
  </body>
</html>
