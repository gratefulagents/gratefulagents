# Default user runtime image.
#
# This image includes all toolchain dependencies needed to build and develop
# the gratefulagents repo. Operator-controlled tools (the agent binary plus
# static fallback copies of git, gh, rg, fd, jq, curl, and bwrap) are injected
# at runtime via the injector init container.
#
# Users can build their own runtime image with any glibc-based Linux distro
# and their project's toolchain. Requirements:
#   - glibc-based Linux (Ubuntu, Debian, Fedora, Amazon Linux) on amd64/arm64
#   - a shell (bash)
# Everything else (git, gh, curl, jq, rg, fd, bubblewrap, CA bundle) is
# injected as a PATH-last fallback — the image's own tools win when present.
FROM golang:1.26

# ── System packages ──────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    ca-certificates \
    bubblewrap \
    make \
    jq \
    unzip \
    chromium \
    python3 \
    python3-pip \
    ripgrep \
    fd-find \
    bat \
    tree \
    less \
    sed \
    gawk \
    diffutils \
    patch \
    file \
    build-essential \
    autoconf \
    m4 \
    libncurses-dev \
    inotify-tools \
    clang \
    libclang-dev \
    llvm-dev \
    && rm -rf /var/lib/apt/lists/*

# clang/libclang above are for Rust crates that generate bindings at build
# time (bindgen, used by e.g. xdelta3 in sigp/lighthouse and by fastcrypto
# consumers such as MystenLabs/seal). Without libclang the principal build of
# those targets fails inside the sandbox, where apt-get is unavailable.

# ── CLI tool symlinks (Debian renames some binaries) ─────────────────────────
RUN ln -sf /usr/bin/fdfind /usr/local/bin/fd 2>/dev/null || true \
    && ln -sf /usr/bin/batcat /usr/local/bin/bat 2>/dev/null || true

# ── uv (Python package runner, provides uvx for MCP servers) ─────────────────
# Install directly into /usr/local/bin. The installer's default drops the
# binaries under /root/.local/bin, and /root is 0700 — run pods execute as a
# non-root uid (see runAsUser below), so symlinks into /root resolve to
# "permission denied" and every uvx-based MCP server fails to spawn.
RUN curl -fsSL https://astral.sh/uv/install.sh \
    | env UV_INSTALL_DIR="/usr/local/bin" INSTALLER_NO_MODIFY_PATH=1 sh \
    && uv --version && uvx --version

# ── GitHub CLI ───────────────────────────────────────────────────────────────
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# ── Docker CLI (client only) ─────────────────────────────────────────────────
# Runs with spec.dockerInDocker enabled get a docker:dind sidecar; the worker
# only needs the client (plus buildx/compose plugins) and talks to the daemon
# via DOCKER_HOST. Without the sidecar the CLI is inert.
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli docker-buildx-plugin docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# ── kubectl ──────────────────────────────────────────────────────────────────
RUN ARCH="$(dpkg --print-architecture)" \
    && curl -fsSL "https://dl.k8s.io/release/v1.34.3/bin/linux/${ARCH}/kubectl" -o /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl

# ── protoc (Protocol Buffers compiler) ───────────────────────────────────────
RUN ARCH="$(uname -m)" \
    && if [ "$ARCH" = "x86_64" ]; then PB_ARCH="x86_64"; elif [ "$ARCH" = "aarch64" ]; then PB_ARCH="aarch_64"; fi \
    && curl -fsSL "https://github.com/protocolbuffers/protobuf/releases/download/v33.4/protoc-33.4-linux-${PB_ARCH}.zip" -o /tmp/protoc.zip \
    && unzip -q /tmp/protoc.zip -d /usr/local \
    && rm /tmp/protoc.zip

# ── buf (protobuf toolchain) ─────────────────────────────────────────────────
# Build buf from the Go module instead of downloading the prebuilt GitHub
# release binary. This avoids transient GitHub release CDN failures during
# worker image builds.
RUN GOBIN=/usr/local/bin go install github.com/bufbuild/buf/cmd/buf@v1.61.0 \
    && /usr/local/bin/buf --version

# ── gopls (Go language server) ───────────────────────────────────────────────
RUN GOBIN=/usr/local/bin go install golang.org/x/tools/gopls@latest \
    && /usr/local/bin/gopls version

# ── Runtime user ─────────────────────────────────────────────────────────────
RUN useradd -m -s /bin/bash -u 1100 worker \
    && mkdir -p /workspace \
    && chown worker:worker /workspace

# ── Rust ─────────────────────────────────────────────────────────────────────
ARG RUST_VERSION=1.97.1
ARG RUSTUP_VERSION=1.28.2
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:${PATH}
RUN ARCH="$(dpkg --print-architecture)" \
    && case "$ARCH" in \
        amd64) RUSTUP_TARGET="x86_64-unknown-linux-gnu"; RUSTUP_SHA256="20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c" ;; \
        arm64) RUSTUP_TARGET="aarch64-unknown-linux-gnu"; RUSTUP_SHA256="e3853c5a252fca15252d07cb23a1bdd9377a8c6f3efa01531109281ae47f841c" ;; \
        *) echo "unsupported architecture: $ARCH" >&2; exit 1 ;; \
    esac \
    && curl --proto '=https' --tlsv1.2 -fsSL \
        "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${RUSTUP_TARGET}/rustup-init" \
        -o /tmp/rustup-init \
    && echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --profile default --default-toolchain "$RUST_VERSION" \
    && rm /tmp/rustup-init \
    && rustc --version \
    && cargo --version \
    && chown -R worker:worker "$RUSTUP_HOME" "$CARGO_HOME"

# ── Rust nightly + cargo-fuzz (in-sandbox fuzz iteration) ───────────────────
# The fuzz-researcher role iterates on harnesses inside the sandbox: author a
# target, run a bounded campaign, read the crash, fix the harness, repeat. The
# registered cargo-fuzz adapter (Dockerfile.security-tools) stays the
# provenance-bearing path for recorded campaigns, but it stages the whole
# workspace per run, which is too slow for that loop. cargo-fuzz needs a
# nightly toolchain for -Zsanitizer; pin the nightly by date and the crate by
# version (same version as the security-tools image) so the image is
# reproducible.
ARG RUST_NIGHTLY=nightly-2026-09-03
ARG CARGO_FUZZ_VERSION=0.13.2
RUN rustup toolchain install "$RUST_NIGHTLY" --profile minimal --component rust-src llvm-tools \
    && cargo "+$RUST_NIGHTLY" install cargo-fuzz --version "$CARGO_FUZZ_VERSION" --locked \
    && cargo "+$RUST_NIGHTLY" fuzz --version \
    && rm -rf "$CARGO_HOME/registry" "$CARGO_HOME/git" \
    && chown -R worker:worker "$RUSTUP_HOME" "$CARGO_HOME"
ENV GA_RUST_NIGHTLY=${RUST_NIGHTLY}

# ── LLVM 22 (llvm-sys consumers such as paradigmxyz/reth) ───────────────────
# reth's default build pulls llvm-sys 221, which needs a system LLVM 22 found
# through LLVM_SYS_221_PREFIX. The Debian clang/llvm-dev above stays for
# bindgen; this adds the apt.llvm.org toolchain side by side. libpolly is a
# hard link-time dependency of llvm-sys.
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key -o /etc/apt/keyrings/apt.llvm.org.asc \
    && chmod a+r /etc/apt/keyrings/apt.llvm.org.asc \
    && CODENAME="$(. /etc/os-release && echo "$VERSION_CODENAME")" \
    && echo "deb [signed-by=/etc/apt/keyrings/apt.llvm.org.asc] https://apt.llvm.org/${CODENAME}/ llvm-toolchain-${CODENAME}-22 main" > /etc/apt/sources.list.d/apt-llvm-org-22.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends llvm-22 llvm-22-dev libpolly-22-dev libclang-22-dev libzstd-dev zlib1g-dev libffi-dev \
    && rm -rf /var/lib/apt/lists/* \
    && /usr/lib/llvm-22/bin/llvm-config --version
ENV LLVM_SYS_221_PREFIX=/usr/lib/llvm-22

# ── Flow CLI (onflow emulator / localnet PoCs) ──────────────────────────────
# Flow bounty programs require execution-layer PoCs to run against the Flow
# CLI emulator or a localnet, and the sandbox cannot install it. Pin the
# release and verify against the published checksums.txt, mirroring the
# rustup and Temurin installs. The archive ships a single `flow-cli` binary.
ARG FLOW_CLI_VERSION=2.18.0
RUN ARCH="$(dpkg --print-architecture)" \
    && case "$ARCH" in \
        amd64) FLOW_SHA256="a3747785007c09f163fe5facdc2ecab2312e267902399e9f5ee4c5b90d310e9e" ;; \
        arm64) FLOW_SHA256="18c1a408b56b264fbe739684679ee813e21d963a0c9b311ddc3f670c0076c6aa" ;; \
        *) echo "unsupported architecture: $ARCH" >&2; exit 1 ;; \
    esac \
    && curl --proto '=https' --tlsv1.2 -fsSL \
        "https://github.com/onflow/flow-cli/releases/download/v${FLOW_CLI_VERSION}/flow-cli-v${FLOW_CLI_VERSION}-linux-${ARCH}.tar.gz" \
        -o /tmp/flow-cli.tar.gz \
    && echo "${FLOW_SHA256}  /tmp/flow-cli.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/flow-cli.tar.gz -C /tmp flow-cli \
    && install -m 0755 /tmp/flow-cli /usr/local/bin/flow \
    && rm -f /tmp/flow-cli /tmp/flow-cli.tar.gz \
    && flow version

# ── Java (Eclipse Temurin JDK) ───────────────────────────────────────────────
# Gradle-based JVM targets (Consensys/teku, hyperledger/besu) require a JDK at
# or above their toolchain floor (currently 25) and cannot install one inside
# the read-only sandbox. Pin the release and verify its checksum, mirroring
# the rustup install above.
ARG TEMURIN_RELEASE=jdk-25.0.4.1+1
ENV JAVA_HOME=/usr/local/java
ENV PATH=${JAVA_HOME}/bin:${PATH}
RUN ARCH="$(dpkg --print-architecture)" \
    && case "$ARCH" in \
        amd64) TEMURIN_ARCH="x64"; TEMURIN_SHA256="dbb698396d478e7fa2b1e50f4103324b2a99b90569ee27c33f2261f9215cf41e" ;; \
        arm64) TEMURIN_ARCH="aarch64"; TEMURIN_SHA256="69df11a02cfa3ef7d7ca645e03edce6778ec090e100f6ae2b42097865730ac52" ;; \
        *) echo "unsupported architecture: $ARCH" >&2; exit 1 ;; \
    esac \
    && TEMURIN_TAG="$(printf '%s' "$TEMURIN_RELEASE" | sed 's/+/%2B/')" \
    && TEMURIN_FILE="OpenJDK25U-jdk_${TEMURIN_ARCH}_linux_hotspot_$(printf '%s' "$TEMURIN_RELEASE" | sed -e 's/^jdk-//' -e 's/+/_/').tar.gz" \
    && curl --proto '=https' --tlsv1.2 -fsSL \
        "https://github.com/adoptium/temurin25-binaries/releases/download/${TEMURIN_TAG}/${TEMURIN_FILE}" \
        -o /tmp/temurin.tar.gz \
    && echo "${TEMURIN_SHA256}  /tmp/temurin.tar.gz" | sha256sum -c - \
    && mkdir -p "$JAVA_HOME" \
    && tar -xzf /tmp/temurin.tar.gz -C "$JAVA_HOME" --strip-components=1 \
    && rm /tmp/temurin.tar.gz \
    && java -version

# ── Tauri Linux build dependencies (platform-app/tauri) ─────────────────────
# Lets worker runs compile the Tauri desktop shell on Linux (cargo check /
# clippy / test in platform-app/tauri/src-tauri). Follows the official Tauri
# v2 Debian prerequisites plus dbus headers; the tray-icon feature needs
# libayatana-appindicator3-dev.
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev \
    libjavascriptcoregtk-4.1-dev \
    libsoup-3.0-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    libxdo-dev \
    libdbus-1-dev \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# ── Node.js + pnpm (for web/ frontend) ──────────────────────────────────────
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable && corepack prepare pnpm@10.25.0 --activate

# ── Erlang + Elixir (from GitHub releases) ───────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    gnupg \
    curl \
    wget \
    locales \
    && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen \
    && locale-gen \
    && wget -qO- https://packages.erlang-solutions.com/ubuntu/erlang_solutions.asc 2>/dev/null | gpg --dearmor -o /etc/apt/trusted.gpg.d/erlang.gpg 2>/dev/null || true \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/trusted.gpg.d/erlang.gpg] https://packages.erlang-solutions.com/debian bookworm contrib" > /etc/apt/sources.list.d/erlang.list || true \
    && apt-get update || true \
    && apt-get install -y --no-install-recommends \
    erlang-base \
    erlang-crypto \
    erlang-public-key \
    erlang-ssl \
    erlang-inets \
    erlang-dev \
    erlang-parsetools \
    erlang-syntax-tools \
    erlang-xmerl \
    || true \
    && rm -rf /var/lib/apt/lists/*

# Install Elixir 1.19 from hex.pm builds (matching OTP 27)
RUN ELIXIR_VERSION="1.19" \
    && wget -q "https://builds.hex.pm/builds/elixir/v${ELIXIR_VERSION}-otp-27.zip" -O /tmp/elixir.zip \
    && unzip -q /tmp/elixir.zip -d /usr/local \
    && rm /tmp/elixir.zip

# ── Elixir locale (must be set globally so the BEAM VM uses UTF-8) ────────────
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV ELIXIR_ERL_OPTIONS="+fnu"

# ── Phoenix dependencies (as worker user) ─────────────────────────────────────
RUN su worker -c "git config --global user.name 'gratefulagents[bot]' && git config --global user.email '292420648+gratefulagents[bot]@users.noreply.github.com'" \
    && su worker -c "mix local.hex --force && mix local.rebar --force && mix archive.install hex phx_new --force"

USER worker
WORKDIR /workspace
